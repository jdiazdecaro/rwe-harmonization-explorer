# Copy to .env and fill in to enable LIVE Airtable data during local dev.
# Leave unset (e.g. on the public GitHub Pages build) to use the bundled
# static fallback data. Never commit the real .env — it is gitignored.
VITE_AIRTABLE_TOKEN=your_airtable_personal_access_token
VITE_AIRTABLE_BASE_ID=your_airtable_base_id
